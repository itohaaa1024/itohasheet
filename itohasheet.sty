% オプション：分割数の決定（デフォルトは3）
\newcommand*{\ws@divide}{3}
\newcommand*{\ws@setdivide}[1]{%
  \edef\ws@tmp{\number\numexpr#1\relax}%
  \ifnum\ws@tmp<2
    \PackageError{itohasheet}{divide=#1 は使えません}{2〜4の整数を指定してください。}%
  \else\ifnum\ws@tmp>4
    \PackageError{itohasheet}{divide=#1 は使えません}{2〜4の整数を指定してください。}%
  \else
    \global\let\ws@divide\ws@tmp
  \fi\fi}

% オプション：解答表示（氏名のところに「解答例（デフォルト）」と表示）
\newif\ifws@answer \ws@answerfalse

\DeclareKeys[itohasheet]{
  divide.code = \ws@setdivide{#1},
  divide.code = \ws@setdivide{#1},
  answer.if   = ws@answer,
}
\ProcessKeyOptions[itohasheet]

% 文書の基本設定
\geometry{top=20mm,bottom=12.5mm,left=7.5mm,right=7.5mm}
\setlength{\columnsep}{0.5\zw}
\setlength{\parindent}{0\zw}
\pagestyle{empty}



% 環境：分割（オプションの分割数に対応）
\NewDocumentEnvironment{分割}{O{\ws@divide}}
  {\begin{multicols*}{#1}}
  {\end{multicols*}}


% 寸法
\newlength{\ws@side}
  \setlength{\ws@side}{7.5mm}       % 左右の余白
\newlength{\ws@headline}
  \setlength{\ws@headline}{17.5mm}  % 上の余白
\newlength{\ws@footline}
  \setlength{\ws@footline}{12.5mm}    % 下の余白

% タイトル
\newcommand*{\ws@title}{【ここにメインタイトルを記入】}
\newcommand*{\ws@answername}{}
\NewDocumentCommand{\タイトル}{m O{解答例}}{%
  \gdef\ws@title{#1}%
  \IfValueT{#2}{\gdef\ws@answername{#2}}}

% 枠の表示・非表示
\newif\ifws@frame     \ws@frametrue
\newif\ifws@skipthis  \ws@skipthisfalse
\newcommand{\ShowWorksheetFrame}{\global\ws@frametrue}
\newcommand{\HideWorksheetFrame}{\global\ws@framefalse}
\newcommand{\NoWorksheetFrameThisPage}{\global\ws@skipthistrue}

\AddToHook{shipout/background}{%
  \ifws@skipthis
    \global\ws@skipthisfalse
  \else\ifws@frame
  \begin{tikzpicture}[overlay, remember picture]
    % 座標を設定
    \coordinate (NW) at (current page.north west);
    \coordinate (NE) at (current page.north east);
    \coordinate (S)  at (current page.south);
    \coordinate (L)  at ([xshift=\ws@side,yshift=-\ws@headline]NW);
    \coordinate (R)  at ([xshift=-\ws@side,yshift=-\ws@headline]NE);

    % ヘッダーの線
    \draw[line width=0.6pt] (L) -- (R);

    % 段区切り線（オプションの分割数に対応）
    \pgfmathtruncatemacro{\ws@lastline}{\ws@divide-1}%
    \foreach \ws@i in {1,...,\ws@lastline}{%
      \coordinate (D) at ($(L)!\ws@i/\ws@divide!(R)$);
      \draw[line width=0.6pt] (D) -- ([yshift=\ws@footline]D |- S);
    }

    % メインタイトルをnode
    \node[anchor=west,font=\reimin\large] at ([yshift=6mm]L) {\ws@title};

    % 氏名の記入
    \node[anchor=base east,font=\reimin\large,inner sep=0pt] 
      (ws@nameclose) at ([xshift=-1mm,yshift=5mm]R) {）};
    \node[anchor=base east,font=\reimin\large,inner sep=0pt,minimum width=55mm]
      (ws@namebox) at (ws@nameclose.base west) {\strut};
    \node[anchor=base east,font=\reimin\large,inner sep=0pt]
      at (ws@namebox.base west) {（\hspace{6truemm}）\hspace{-0.55\zw}組\hspace{-0.55\zw}（\hspace{6truemm}）\hspace{-0.55\zw}番\hspace{5truemm}名前\hspace{-0.55\zw}（};

    % 解答表示：名前欄のカッコのちょうど真ん中
    \ifws@answer
      \node[anchor=base,color=magenta,font=\large,inner sep=0pt]
        at (ws@namebox.base) {\ws@answername};
    \fi

    % ページ番号
    \node at ([yshift=5mm]S) {\raisebox{0.25ex}{-}\,\thepage\,\raisebox{0.25ex}{-}};
  \end{tikzpicture}%
  \fi\fi
}


