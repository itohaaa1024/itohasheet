% 問題文挿入用ボックス
\DeclareTColorBox{dummybox}{O{}}{%
  blank,breakable,
  top=0mm,bottom=0mm,left=0mm,right=0mm,
  boxsep=0mm,#1
}

% 問題番号
\newcommand{\mondaibangou}[1]{%
  \setlength{\fboxrule}{0.6pt}%
  \setlength{\fboxsep}{0.5pt}%
  \fbox{\parbox[c][0.92\zw][c]{0.925\zw}{\centering\small #1}}}

% 問題番号カウンタ
\newcounter{mondai}

% 問題文挿入
\NewDocumentEnvironment{問題挿入}{O{1} m d<>}
  {\begin{dummybox}%
    \stepcounter{mondai}
    \mondaibangou{#2}
    \IfValueT{#3}{[#3]}\par}
  {\end{dummybox}
  \vspace{#1\zw}}

% 穴埋め枠
\NewDocumentCommand{\穴埋め枠}{O{3.25} m}{%
  \setlength{\fboxrule}{0.8pt}%
  \setlength{\fboxsep}{-0.4pt}%
  \,\framebox[#1\zw][c]{\mbox{#2}}\,}

% 
\NewDocumentCommand{\解答欄}{O{black}}{%
  \raisebox{0.2ex}{\tikz[baseline=(X.base)]\node[
    draw=#1,line width=0.6pt,text=#1,inner sep=0pt,rounded corners=1pt,
    font=\footnotesize\sffamily\gtfamily,
    minimum width=3\zw,minimum height=1\zw](X){解答欄};}\hspace{1\zw}%
}

% 解答文挿入用ボックス
\NewDocumentCommand{\解答}{O{magenta}}{%
  \raisebox{0.2ex}{\tikz[baseline=(X.base)]\node[%
    draw=#1,line width=0.6pt,text=#1,inner sep=0pt,rounded corners=1pt,%
    font=\footnotesize\sffamily\gtfamily,%
    minimum width=2\zw,minimum height=1\zw](X){解答};}\hspace{1\zw}%
  }

% 解答文挿入
\NewDocumentEnvironment{解答挿入}{}
  {\begin{dummybox}[coltext=magenta]\解答}
  {\end{dummybox}}




